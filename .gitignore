# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build artefacts
build/
dist/
*.egg-info/
.eggs/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor and OS files
.idea/
.vscode/
*.swp
*~
.DS_Store

# Extractor output. The two conventional output directory names are
# ignored here, and packets in them are working papers rather than
# source. A run pointed at any other directory is the caller's to
# clean up, because the extractor writes wherever its out flag says.
packet/
packets/
